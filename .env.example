# xBloom AI Brew Studio local configuration
# Copy to .env only when you prefer file-based settings. The desktop UI can save
# the model URL, model names and API keys locally on Windows.

# OpenAI-compatible text model gateway (all values belong to the local user)
LLM_BASE_URL=
# Optional for custom native endpoints: openai-compatible | anthropic | gemini
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional fallback channel/model chain
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_THIRD_MODEL=
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0.3
# Single model request / full generation deadline (milliseconds)
LLM_REQUEST_TIMEOUT_MS=120000
GENERATION_TIMEOUT_MS=300000

# Recipe generation and research policy
# Legacy API default only. Desktop FAST/PRO always generate 1; MAX always 3.
GENERATE_CANDIDATES=3
CANDIDATE_SCORE_THRESHOLD=70
RESEARCH_RETRY_MAX_ROUNDS=1

# Optional xBloom auto-login. Leave blank to sign in from the Cloud page.
XBLOOM_EMAIL=
XBLOOM_PASSWORD=
# global = client-api.xbloom.com; cn = clientcn-api.xbloomcoffee.cn
XBLOOM_REGION=global

# Optional outbound proxy
HTTPS_PROXY=
ALL_PROXY=

# Optional BLE direct connection
XBLOOM_DEVICE_NAME=
XBLOOM_BLE_SCAN_TIMEOUT_MS=15000

# Optional local research services
SEARXNG_URL=http://127.0.0.1:8899
XHS_MCP_URL=http://127.0.0.1:18060
# false opens a normal browser for better Windows compatibility; true is fully hidden.
XHS_HEADLESS=true
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true

# Local backend
PORT=8787
# Local Vite desktop UI (used by the Windows watchdog)
WEB_PORT=5180
