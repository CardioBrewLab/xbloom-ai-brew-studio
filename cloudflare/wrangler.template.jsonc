{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xbloom-ai-brew-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xbloom-ai-brew-studio-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Leave blank for account-owned BYOK. A deployer-wide guest model is optional.
    "LLM_BASE_URL": "https://YOUR_OPENAI_COMPATIBLE_HOST/v1",
    "LLM_MODEL": "YOUR_MODEL_ID",
    // Free-tier guardrails. Raise these after confirming the current Browser Run plan.
    "XHS_BROWSER_QR_DAILY_LIMIT": "3",
    "XHS_BROWSER_SEARCH_DAILY_LIMIT": "20",
  },
  "observability": {
    "enabled": true,
  },
}
